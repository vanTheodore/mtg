{
  "name": "mesa-mtg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "dev": "bun --bun node_modules/vite/bin/vite.js dev --host 0.0.0.0",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src/lib",
    "test:e2e": "bun --bun playwright test",
    "engine:build": "bun scripts/build-engine.ts",
    "engine:optimize": "bun scripts/optimize-wasm.ts",
    "catalog:build": "bun scripts/build-catalog.ts",
    "verify": "bun run check && bun test src/lib && bun run engine:verify && bun run build",
    "engine:parity": "bun scripts/parity.ts",
    "engine:scenarios": "bun scripts/scenarios.ts",
    "engine:verify": "bun scripts/verify-engine.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "1.4.4",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
